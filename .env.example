# Copy this file to ".env" and fill in the values. Docker Compose reads it.

# The secret that the rendezvous server and coturn share, to sign and check
# temporary TURN usernames. Create one with: openssl rand -hex 32
SCREENSY_TURN_SECRET=

# The STUN and TURN servers that clients use, comma-separated. "{host}" stands
# for the host name of the page. Leave a line commented out to keep its
# default; set it to nothing to turn it off.
# SCREENSY_STUN_URLS=stun:{host}
# SCREENSY_TURN_URLS=turn:{host}

# For example, inside a tailnet (the Tailscale name or address of this machine):
# SCREENSY_STUN_URLS=stun:myhost.example.ts.net
# SCREENSY_TURN_URLS=turn:myhost.example.ts.net

# Or a public STUN server, which learns the participants' IP addresses:
# SCREENSY_STUN_URLS=stun:stun.l.google.com:19302

# How long a temporary TURN username stays valid, in seconds (default: a day).
# SCREENSY_TURN_TTL_S=86400
