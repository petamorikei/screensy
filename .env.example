# Copy this file to ".env" to change the defaults. Docker Compose reads it.
# Leave a line commented out to keep its default.

# The STUN servers that clients use, comma-separated (default: Cloudflare's
# public STUN server). Set it to nothing to turn STUN off. "{host}" stands for
# the host name of the page, for a STUN server that you run on this machine
# (see "STUN servers" in the README).
# SCREENSY_STUN_URLS=stun:stun.cloudflare.com:3478

# The number of people that can present at the same time (default: 4).
# SCREENSY_MAX_PRESENTERS=4
