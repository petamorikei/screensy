# Copy this file to ".env" to change the defaults. Docker Compose reads it.
# Leave a line commented out to keep its default.

# The STUN servers that clients use, comma-separated. "{host}" stands for the
# host name of the page, which runs coturn in docker-compose.yaml. Set it to
# nothing to turn STUN off.
# SCREENSY_STUN_URLS=stun:{host}

# Inside a tailnet only (tailscale serve): keep the default. Inside the tailnet,
# the page's name resolves to the Tailscale address of this machine, so the
# browsers learn their Tailscale addresses and Tailscale connects them.

# With Tailscale Funnel: viewers outside the tailnet cannot reach coturn, so add
# a public STUN server, which learns the participants' IP addresses:
# SCREENSY_STUN_URLS=stun:{host},stun:stun.cloudflare.com:3478

# The number of people that can present at the same time (default: 4).
# SCREENSY_MAX_PRESENTERS=4
