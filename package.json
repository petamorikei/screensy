{
  "name": "screensy",
  "private": true,
  "description": "Simple peer-to-peer screen sharing",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "check": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:protocol": "node tests/protocol.mjs",
    "test:e2e": "pnpm --filter screensy-website build && node tests/e2e.mjs",
    "prepare": "mise exec -- prek install",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
